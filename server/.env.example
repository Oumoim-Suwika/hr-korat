# Sati backend configuration
# ---------------------------------------------------------------
# DB_DRIVER: "pglite" (local dev, embedded Postgres, no server needed)
#            or "pg" (production, e.g. Amazon Aurora PostgreSQL)
DB_DRIVER=pglite

# Local PGlite data directory (used when DB_DRIVER=pglite)
PGLITE_DIR=./.data/pglite

# Production Postgres / Aurora connection (used when DB_DRIVER=pg)
# DATABASE_URL=postgres://user:pass@your-aurora-endpoint:5432/sati

# JWT signing secret — CHANGE THIS in production (use AWS Secrets Manager)
JWT_SECRET=dev-only-change-me-please

# HTTP port
PORT=4000

# Comma-separated list of allowed CORS origins (the frontend URL)
CORS_ORIGIN=http://localhost:3000
